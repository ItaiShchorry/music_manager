{
  "allowedCommands": [
    "npm install",
    "npm run dev",
    "npm run build",
    "npm run test",
    "pip install",
    "python -m pytest",
    "alembic revision",
    "alembic upgrade head",
    "git status",
    "git diff",
    "git log",
    "git branch",
    "git add",
    "git checkout",
    "git merge",
    "docker-compose up",
    "docker-compose down"
  ],

  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp-server"]
    }
  }
}